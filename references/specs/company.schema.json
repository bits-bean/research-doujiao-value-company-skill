{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doujiao-value-system/schemas/company.schema.json",
  "title": "Doujiao Value System Company Schema",
  "description": "豆角长期价值研究系统的公司结构化数据协议。用于约束 AI 研究输出、网站导入、自动化更新与多平台内容生成。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "classification",
    "brand_identity",
    "verdict",
    "reporting",
    "financials",
    "industry_metrics",
    "income_statement_sankey",
    "segments",
    "capital_allocation",
    "buyback_ledger",
    "debt_maturities",
    "moat",
    "durability",
    "management",
    "valuation",
    "risks",
    "sources"
  ],
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "classification": {
      "$ref": "#/$defs/classification"
    },
    "brand_identity": {
      "$ref": "#/$defs/brandIdentity"
    },
    "verdict": {
      "$ref": "#/$defs/verdict"
    },
    "reporting": {
      "$ref": "#/$defs/reporting"
    },
    "financials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/financialPeriod"
      }
    },
    "industry_metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/industryMetric"
      }
    },
    "income_statement_sankey": {
      "$ref": "#/$defs/sankey"
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "capital_allocation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capitalAllocationItem"
      }
    },
    "buyback_ledger": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/buybackItem"
      }
    },
    "debt_maturities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/debtMaturity"
      }
    },
    "moat": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/moatItem"
      }
    },
    "durability": {
      "$ref": "#/$defs/durability"
    },
    "management": {
      "$ref": "#/$defs/management"
    },
    "valuation": {
      "$ref": "#/$defs/valuation"
    },
    "risks": {
      "$ref": "#/$defs/risks"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "nullableNumber": {
      "type": ["number", "null"]
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "ratio": {
      "type": ["number", "null"],
      "description": "比例统一使用十进制小数表示：0.25 = 25%，-0.10 = -10%。"
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sector",
        "primary_industry",
        "secondary_industries",
        "accounting_profile",
        "returns_profile",
        "source_ids"
      ],
      "properties": {
        "sector": {
          "type": "string",
          "enum": [
            "consumer_staples",
            "consumer_discretionary",
            "financials",
            "healthcare",
            "industrials",
            "information_technology",
            "communication_services",
            "energy",
            "materials",
            "utilities",
            "real_estate",
            "other"
          ]
        },
        "primary_industry": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "secondary_industries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "accounting_profile": {
          "type": "string",
          "enum": [
            "standard_corporate",
            "regulated_bank",
            "insurer",
            "reit",
            "resource_cycle"
          ]
        },
        "returns_profile": {
          "type": "string",
          "enum": [
            "standard_roic",
            "regulated_bank",
            "payments_credit",
            "payments_network",
            "insurer",
            "reit",
            "resource_cycle",
            "software_platform"
          ]
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "industryMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "code",
        "label",
        "value",
        "value_type",
        "source_ids"
      ],
      "properties": {
        "period": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/nullableNumber"
        },
        "value_type": {
          "type": "string",
          "enum": ["amount", "ratio", "per_share", "multiple", "count", "index"]
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_name_cn",
        "company_name_en",
        "ticker",
        "exchange",
        "fiscal_year_end",
        "report_currency",
        "financial_unit",
        "share_unit",
        "ratio_convention",
        "valuation_date",
        "data_as_of",
        "accounting_standard",
        "display_language",
        "source_version",
        "schema_version",
        "theme",
        "sankey_style"
      ],
      "properties": {
        "company_name_cn": {
          "type": "string",
          "minLength": 1
        },
        "company_name_en": {
          "type": "string",
          "minLength": 1
        },
        "ticker": {
          "type": "string",
          "minLength": 1
        },
        "exchange": {
          "type": "string",
          "minLength": 1
        },
        "fiscal_year_end": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "report_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 报告货币代码，例如 CNY、USD、HKD。"
        },
        "financial_unit": {
          "type": "string",
          "const": "unit",
          "default": "unit",
          "description": "除每股价格外，company.json 内货币金额必须写成报告币种的实际原始数值，不得按千、百万或十亿缩放。例如人民币100万元写为1000000。"
        },
        "share_unit": {
          "type": "string",
          "const": "share",
          "default": "share",
          "description": "股数类字段必须写成实际股数，不得按千股、百万股或十亿股缩放。例如100万股写为1000000。"
        },
        "ratio_convention": {
          "type": "string",
          "const": "decimal",
          "default": "decimal",
          "description": "所有百分比、增长率、利润率、ROE/ROIC、折现率等比例字段均使用十进制小数：0.25 = 25%。"
        },
        "valuation_date": {
          "type": "string",
          "format": "date"
        },
        "data_as_of": {
          "type": "string",
          "format": "date"
        },
        "accounting_standard": {
          "type": "string",
          "minLength": 1
        },
        "display_language": {
          "type": "string",
          "default": "zh-CN"
        },
        "source_version": {
          "type": "string",
          "minLength": 1,
          "description": "研究方法 / Instructions / Knowledge 版本。"
        },
        "schema_version": {
          "type": "string",
          "enum": ["2.0.0", "2.1.0"],
          "default": "2.1.0",
          "description": "company.json 数据协议版本。2.1.0 新增报告口径的普通股股东利润与稀释 EPS；2.0.0 仅为向后兼容既有冻结包。"
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "sankey_style": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "logoAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_path", "source_url", "alt", "is_official"],
      "properties": {
        "asset_path": {
          "$ref": "#/$defs/nullableString"
        },
        "source_url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "alt": {
          "$ref": "#/$defs/nullableString"
        },
        "is_official": {
          "type": "boolean"
        }
      }
    },
    "brandPalette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "accent"],
      "properties": {
        "primary": {
          "$ref": "#/$defs/nullableString"
        },
        "secondary": {
          "$ref": "#/$defs/nullableString"
        },
        "accent": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "brandIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_logo",
        "brand_palette",
        "product_brands",
        "visual_motif",
        "independent_research_label"
      ],
      "properties": {
        "company_logo": {
          "$ref": "#/$defs/logoAsset"
        },
        "brand_palette": {
          "$ref": "#/$defs/brandPalette"
        },
        "product_brands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visual_motif": {
          "$ref": "#/$defs/nullableString"
        },
        "independent_research_label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "business_quality",
        "valuation_status",
        "research_status",
        "confidence",
        "one_sentence",
        "key_assumptions",
        "thesis_breakers"
      ],
      "properties": {
        "business_quality": {
          "type": "string"
        },
        "valuation_status": {
          "type": "string"
        },
        "research_status": {
          "type": "string"
        },
        "confidence": {
          "type": "string"
        },
        "one_sentence": {
          "type": "string",
          "minLength": 1
        },
        "key_assumptions": {
          "$ref": "#/$defs/stringArray"
        },
        "thesis_breakers": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "reportRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period", "report_date", "date_status", "source_ids"],
      "properties": {
        "period": {
          "type": "string",
          "minLength": 1,
          "description": "例如 2026Q2、2025FY。"
        },
        "period_type": {
          "type": ["string", "null"],
          "enum": ["FY", "Q1", "Q2", "Q3", "Q4", "H1", "H2", null]
        },
        "report_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "date_status": {
          "type": "string",
          "enum": ["official", "estimated", "unknown"]
        },
        "filing_url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latest_report", "next_expected_report"],
      "properties": {
        "latest_report": {
          "$ref": "#/$defs/reportRecord"
        },
        "next_expected_report": {
          "$ref": "#/$defs/reportRecord"
        },
        "last_checked_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "自动化系统最近一次检查财报发布状态的时间。"
        },
        "monitoring_notes": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "financialPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "period_type",
        "revenue",
        "gross_profit",
        "operating_profit",
        "net_income",
        "operating_cash_flow",
        "capex_total",
        "free_cash_flow",
        "cash",
        "total_debt",
        "net_debt",
        "is_estimate",
        "source_ids"
      ],
      "properties": {
        "period": {
          "type": "string",
          "minLength": 1
        },
        "period_type": {
          "type": "string",
          "enum": ["FY", "Q1", "Q2", "Q3", "Q4", "H1", "H2", "LTM", "TTM"]
        },
        "revenue": {
          "$ref": "#/$defs/nullableNumber"
        },
        "gross_profit": {
          "$ref": "#/$defs/nullableNumber"
        },
        "operating_profit": {
          "$ref": "#/$defs/nullableNumber"
        },
        "net_income": {
          "$ref": "#/$defs/nullableNumber"
        },
        "net_income_attributable_to_common": {
          "$ref": "#/$defs/nullableNumber",
          "description": "归属于普通股股东的利润，使用 report_currency 的实际金额；与包含优先股股息等差异的总净利润 net_income 分开保存。"
        },
        "operating_cash_flow": {
          "$ref": "#/$defs/nullableNumber"
        },
        "capex_total": {
          "$ref": "#/$defs/nullableNumber"
        },
        "capex_maintenance_low": {
          "$ref": "#/$defs/nullableNumber"
        },
        "capex_maintenance_high": {
          "$ref": "#/$defs/nullableNumber"
        },
        "free_cash_flow": {
          "$ref": "#/$defs/nullableNumber"
        },
        "shareholder_adjusted_fcf": {
          "$ref": "#/$defs/nullableNumber"
        },
        "owner_earnings_low": {
          "$ref": "#/$defs/nullableNumber"
        },
        "owner_earnings_high": {
          "$ref": "#/$defs/nullableNumber"
        },
        "gross_margin": {
          "$ref": "#/$defs/ratio"
        },
        "operating_margin": {
          "$ref": "#/$defs/ratio"
        },
        "net_margin": {
          "$ref": "#/$defs/ratio"
        },
        "roic": {
          "$ref": "#/$defs/ratio"
        },
        "roe": {
          "$ref": "#/$defs/ratio"
        },
        "incremental_roic": {
          "$ref": "#/$defs/ratio"
        },
        "cash": {
          "$ref": "#/$defs/nullableNumber"
        },
        "total_debt": {
          "$ref": "#/$defs/nullableNumber"
        },
        "net_debt": {
          "$ref": "#/$defs/nullableNumber"
        },
        "interest_coverage": {
          "$ref": "#/$defs/nullableNumber"
        },
        "sbc": {
          "$ref": "#/$defs/nullableNumber"
        },
        "diluted_shares": {
          "$ref": "#/$defs/nullableNumber"
        },
        "diluted_eps": {
          "$ref": "#/$defs/nullableNumber",
          "description": "公司报告的稀释后每股收益，单位为 report_currency / share；不得用总净利润 net_income 除以稀释股数推导。"
        },
        "dividends": {
          "$ref": "#/$defs/nullableNumber"
        },
        "buybacks": {
          "$ref": "#/$defs/nullableNumber"
        },
        "acquisitions": {
          "$ref": "#/$defs/nullableNumber"
        },
        "is_estimate": {
          "type": "boolean"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "sankeyNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "value"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "category": {
          "$ref": "#/$defs/nullableString"
        },
        "color": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "sankeyLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "value"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "label": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "sankey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fiscal_year",
        "basis",
        "nodes",
        "links",
        "reconciled",
        "source_ids"
      ],
      "properties": {
        "fiscal_year": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "enum": ["income_statement"]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sankeyNode"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sankeyLink"
          }
        },
        "reconciled": {
          "type": "boolean"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period", "name", "revenue", "source_ids"],
      "properties": {
        "period": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "revenue": {
          "$ref": "#/$defs/nullableNumber"
        },
        "operating_profit": {
          "$ref": "#/$defs/nullableNumber"
        },
        "revenue_share": {
          "$ref": "#/$defs/ratio"
        },
        "growth_rate": {
          "$ref": "#/$defs/ratio"
        },
        "notes": {
          "$ref": "#/$defs/nullableString"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "capitalAllocationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "category",
        "amount",
        "lane",
        "result_status",
        "result",
        "assessment",
        "source_ids"
      ],
      "properties": {
        "period": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "amount": {
          "$ref": "#/$defs/nullableNumber"
        },
        "lane": {
          "type": "string",
          "enum": ["reinvest", "risk_reduction", "shareholder_return"]
        },
        "result_status": {
          "type": "string",
          "enum": ["positive", "mixed", "negative", "pending"]
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "assessment": {
          "type": "string",
          "minLength": 1
        },
        "commentary": {
          "$ref": "#/$defs/nullableString"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "buybackItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period", "amount", "source_ids"],
      "properties": {
        "period": {
          "type": "string"
        },
        "amount": {
          "$ref": "#/$defs/nullableNumber"
        },
        "shares_repurchased": {
          "$ref": "#/$defs/nullableNumber"
        },
        "average_price": {
          "$ref": "#/$defs/nullableNumber"
        },
        "shares_outstanding_change": {
          "$ref": "#/$defs/ratio"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "debtMaturity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "amount", "source_ids"],
      "properties": {
        "year": {
          "type": ["integer", "string"]
        },
        "amount": {
          "$ref": "#/$defs/nullableNumber"
        },
        "instrument": {
          "$ref": "#/$defs/nullableString"
        },
        "interest_rate": {
          "$ref": "#/$defs/ratio"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "moatItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "assessment",
        "score",
        "evidence",
        "source_ids"
      ],
      "properties": {
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "assessment": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 5
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "durabilityDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assessment", "evidence", "breaker", "source_ids"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["strong", "adequate", "uncertain", "weak"]
        },
        "assessment": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "breaker": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "durability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horizon_years",
        "overall_status",
        "conclusion",
        "demand_durability",
        "adaptability",
        "external_shocks",
        "source_ids"
      ],
      "properties": {
        "horizon_years": {
          "type": "integer",
          "minimum": 20
        },
        "overall_status": {
          "type": "string",
          "enum": ["durable", "conditional", "fragile", "too_hard"]
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "demand_durability": {
          "$ref": "#/$defs/durabilityDimension"
        },
        "adaptability": {
          "$ref": "#/$defs/durabilityDimension"
        },
        "external_shocks": {
          "$ref": "#/$defs/durabilityDimension"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "managementScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "score", "assessment", "source_ids"],
      "properties": {
        "dimension": {
          "type": "string"
        },
        "score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 5
        },
        "assessment": {
          "type": "string"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "commitmentEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "commitment",
        "status",
        "outcome",
        "next_validation",
        "source_ids"
      ],
      "properties": {
        "date": {
          "type": "string"
        },
        "commitment": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["fulfilled", "partially_fulfilled", "unfulfilled", "pending"]
        },
        "outcome": {
          "$ref": "#/$defs/nullableString"
        },
        "next_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "condition", "timeframe", "source_ids"],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "condition": {
              "type": "string",
              "minLength": 1
            },
            "timeframe": {
              "type": "string",
              "minLength": 1
            },
            "source_ids": {
              "$ref": "#/$defs/sourceIds"
            }
          }
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "management": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scores", "commitment_timeline", "stop_doing_list"],
      "properties": {
        "scores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/managementScore"
          }
        },
        "commitment_timeline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commitmentEvent"
          }
        },
        "stop_doing_list": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "dcfScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fair_value_per_share", "terminal_value_share"],
      "properties": {
        "name": {
          "type": "string"
        },
        "revenue_growth": {
          "$ref": "#/$defs/ratio"
        },
        "margin": {
          "$ref": "#/$defs/ratio"
        },
        "discount_rate": {
          "$ref": "#/$defs/ratio"
        },
        "terminal_growth": {
          "$ref": "#/$defs/ratio"
        },
        "fair_value_per_share": {
          "$ref": "#/$defs/nullableNumber"
        },
        "terminal_value_share": {
          "$ref": "#/$defs/ratio"
        },
        "notes": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "dcfSensitivityCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discount_rate", "terminal_growth", "fair_value_per_share"],
      "properties": {
        "discount_rate": {
          "type": "number"
        },
        "terminal_growth": {
          "type": "number"
        },
        "fair_value_per_share": {
          "type": "number"
        }
      }
    },
    "expectedReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horizon_years", "scenario", "annualized_return"],
      "properties": {
        "horizon_years": {
          "type": "number",
          "minimum": 0
        },
        "scenario": {
          "type": "string"
        },
        "annualized_return": {
          "$ref": "#/$defs/ratio"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "valuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_price",
        "diluted_shares",
        "market_cap",
        "enterprise_value",
        "multiples",
        "dcf_scenarios",
        "dcf_sensitivity",
        "reverse_dcf",
        "fair_value_range",
        "expected_returns"
      ],
      "properties": {
        "market_price": {
          "$ref": "#/$defs/nullableNumber",
          "description": "每股市场价格，单位为 report_currency / share。"
        },
        "diluted_shares": {
          "$ref": "#/$defs/nullableNumber",
          "description": "稀释后实际股数；不得使用千股、百万股或十亿股缩放值。"
        },
        "market_cap": {
          "$ref": "#/$defs/nullableNumber",
          "description": "以 report_currency 表示的实际市值；不得使用千、百万或十亿缩放值。"
        },
        "enterprise_value": {
          "$ref": "#/$defs/nullableNumber",
          "description": "以 report_currency 表示的实际企业价值；不得使用千、百万或十亿缩放值。"
        },
        "multiples": {
          "type": "object",
          "additionalProperties": {
            "type": ["number", "string", "null"]
          }
        },
        "dcf_scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dcfScenario"
          }
        },
        "dcf_sensitivity": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dcfSensitivityCell"
          }
        },
        "reverse_dcf": {
          "type": "object",
          "additionalProperties": true
        },
        "fair_value_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "base", "high", "currency"],
          "properties": {
            "low": {
              "$ref": "#/$defs/nullableNumber"
            },
            "base": {
              "$ref": "#/$defs/nullableNumber"
            },
            "high": {
              "$ref": "#/$defs/nullableNumber"
            },
            "currency": {
              "type": ["string", "null"],
              "pattern": "^[A-Z]{3}$"
            }
          }
        },
        "expected_returns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expectedReturn"
          }
        }
      }
    },
    "riskCausalChain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_path",
        "trigger",
        "operating_impact",
        "capital_cash_impact",
        "value_impact",
        "probability",
        "impact",
        "time_horizon",
        "earliest_warning",
        "reversibility",
        "management_mitigation",
        "source_ids"
      ],
      "properties": {
        "failure_path": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "operating_impact": {
          "type": "string",
          "minLength": 1
        },
        "capital_cash_impact": {
          "type": "string",
          "minLength": 1
        },
        "value_impact": {
          "type": "string",
          "minLength": 1
        },
        "probability": {
          "type": ["string", "null"],
          "enum": ["low", "medium_low", "medium", "medium_high", "high", null]
        },
        "impact": {
          "type": ["string", "null"],
          "enum": ["low", "medium", "high", "severe", "catastrophic", null]
        },
        "time_horizon": {
          "type": "string",
          "minLength": 1
        },
        "earliest_warning": {
          "type": "string",
          "minLength": 1
        },
        "reversibility": {
          "type": "string",
          "enum": [
            "reversible",
            "partially_reversible",
            "hard_to_reverse",
            "irreversible"
          ]
        },
        "management_mitigation": {
          "$ref": "#/$defs/nullableString"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "monitoringIndicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "current_status",
        "trigger",
        "why_it_matters",
        "recheck_method",
        "source_ids"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "current_status": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "recheck_method": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "risks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_mortem",
        "bear_case",
        "fragile_assumptions",
        "monitoring_indicators"
      ],
      "properties": {
        "pre_mortem": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/riskCausalChain"
          }
        },
        "bear_case": {
          "type": "string"
        },
        "fragile_assumptions": {
          "$ref": "#/$defs/stringArray"
        },
        "monitoring_indicators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/monitoringIndicator"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "source_type"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "enum": [
            "annual_report",
            "quarterly_report",
            "earnings_release",
            "earnings_call",
            "investor_presentation",
            "regulatory_filing",
            "official_website",
            "management_interview",
            "news",
            "research",
            "other"
          ]
        },
        "publisher": {
          "$ref": "#/$defs/nullableString"
        },
        "url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "published_at": {
          "type": ["string", "null"],
          "format": "date"
        },
        "accessed_at": {
          "type": ["string", "null"],
          "format": "date"
        },
        "notes": {
          "$ref": "#/$defs/nullableString"
        }
      }
    }
  }
}
